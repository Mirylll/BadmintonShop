{
  "version": 2,
  "buildCommand": "cd backend && npm install && npx prisma generate && npm run build",
  "outputDirectory": ".",
  "functions": {
    "backend/api/index.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/index.ts" }
  ]
}
