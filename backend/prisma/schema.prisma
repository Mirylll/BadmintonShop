generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ADMIN
  CUSTOMER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  IN_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PROCESSED
  SHIPPING
  DELIVERED
  CANCELLED
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserProfile[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Account {
  id          Int           @id @default(autoincrement())
  username    String        @unique
  password    String
  status      AccountStatus @default(ACTIVE)
  accountType AccountType
  createdAt   DateTime      @default(now())
  userProfile UserProfile?
}

model UserProfile {
  id          Int       @id @default(autoincrement())
  fullName    String?
  email       String    @unique
  phone       String?
  avatarUrl   String?
  dateOfBirth DateTime?
  accountId   Int       @unique
  roleId      Int?
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role        Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  addresses   Address[]
  orders      Order[]
  cart        Cart[]
  stockIns    StockIn[]
}

model Address {
  id            Int         @id @default(autoincrement())
  street        String?
  city          String?
  district      String?
  ward          String?
  userProfileId Int
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  orders        Order[]
}

model Category {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  status      ProductStatus @default(IN_STOCK)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    Product[]
}

model Brand {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  logoUrl     String?
  website     String?
  country     String?
  status      ProductStatus @default(IN_STOCK)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    Product[]
  suppliers   Supplier[]
}

model Product {
  id             Int                @id @default(autoincrement())
  name           String
  description    String?
  price          Decimal            @db.Decimal(10, 2)
  discountPrice  Decimal?           @db.Decimal(10, 2)
  stockQuantity  Int                @default(0)
  categoryId     Int?
  brandId        Int?
  status         ProductStatus      @default(IN_STOCK)
  images         Json?
  weight         String?
  sizeOptions    Json?
  specifications Json?
  isFeatured     Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  category       Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand          Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  cart           Cart[]
  orderItems     OrderItem[]
  stockInItems   StockInItem[]
  inventoryHistory InventoryHistory[]

  @@index([categoryId])
  @@index([brandId])
  @@index([price])
}

model Cart {
  userProfileId Int
  productId     Int
  quantity      Int         @default(1)
  addedAt       DateTime    @default(now())
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])

  @@id([userProfileId, productId])
}

model Order {
  id            Int         @id @default(autoincrement())
  userProfileId Int?
  addressId     Int?
  orderDate     DateTime    @default(now())
  totalAmount   Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  paymentMethod String?
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id])
  address       Address?    @relation(fields: [addressId], references: [id])
  orderItems    OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Supplier {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  brandId      Int?
  brand        Brand?    @relation(fields: [brandId], references: [id])
  stockIns     StockIn[]
}

model StockIn {
  id            Int           @id @default(autoincrement())
  supplierId    Int?
  userProfileId Int?
  dateReceived  DateTime      @default(now())
  totalAmount   Decimal       @db.Decimal(10, 2)
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  userProfile   UserProfile?  @relation(fields: [userProfileId], references: [id])
  items         StockInItem[]
}

model StockInItem {
  stockInId Int
  productId Int
  quantity  Int
  unitCost  Decimal  @db.Decimal(10, 2)
  stockIn   StockIn  @relation(fields: [stockInId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@id([stockInId, productId])
}

model InventoryHistory {
  id             Int      @id @default(autoincrement())
  productId      Int
  changeQuantity Int
  type           String   // sale | refund | stock_in | adjustment
  referenceId    Int?
  date           DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])
}